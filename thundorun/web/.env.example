# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── NextAuth ───────────────────────────────────────────
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# 로컬: http://localhost:3000 / 프로덕션: https://your-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ── Admin (레거시 env 폴백 — Supabase 연결 전 dev 용) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

# ── admin_users 시드 스크립트용 ──────────────────────────
# node --env-file=.env.local scripts/seed-admin-users.mjs
ADMIN_ID=admin
# ADMIN_PASSWORD 위와 공유 가능, 또는 별도 지정
USER_ID=user
USER_PASSWORD=your-user-password

# ── Anthropic ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Analytics (GA4) ─────────────────────────────
# analytics.google.com → 속성 → 데이터 스트림(웹)에서 발급받은 측정 ID.
# 설정하면 자동 활성화, 비우면 GA 로드 안 함.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── 외부 발행 API (/api/publish) ───────────────────────
# 외부 자동화 에이전트가 블로그를 발행할 때 쓰는 인증 키(서버 전용, NEXT_PUBLIC 아님).
# 강한 랜덤값 권장: `openssl rand -hex 32`. 미설정 시 /api/publish 는 503(비활성).
BLOG_PUBLISH_API_KEY=
